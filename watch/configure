#!/usr/bin/env bash
# Writes config/Config.mc, which is compiled into the app and is not tracked.
#
#   BATON_URL=https://baton.example.com BATON_WATCH_KEY=<key> ./configure
set -euo pipefail

: "${BATON_URL:?set BATON_URL to the server's base URL}"
: "${BATON_WATCH_KEY:?set BATON_WATCH_KEY to a watch key from the server's web UI}"

[[ $BATON_URL =~ ^https?://[A-Za-z0-9._~:/%-]+$ ]] || { echo "BATON_URL is not a plain http(s) URL" >&2; exit 1; }
[[ $BATON_WATCH_KEY =~ ^[A-Za-z0-9._~+/=-]+$ ]] || { echo "BATON_WATCH_KEY has characters outside A-Za-z0-9._~+/=-" >&2; exit 1; }

target="$(dirname "$0")/config/Config.mc"
umask 077
cat > "$target" <<MC
(:glance)
module Config {
    const SERVER_URL = "$BATON_URL";
    const WATCH_KEY = "$BATON_WATCH_KEY";
}
MC
echo "wrote $target"
